{
  "name": "reproductor-mediator",
  "productName": "Pulse",
  "version": "0.2.0",
  "private": true,
  "description": "Reproductor de música para Windows, Linux y Android con Electron/Capacitor y patrón Mediator",
  "author": "marmol89 <admin@marmol89.com>",
  "main": "src/main/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:android": "node tests/e2e/android.mjs",
    "icons": "node scripts/generate-icon.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "android:build": "node scripts/build-android.mjs && cap sync android",
    "android:apk": "node scripts/android-apk.mjs",
    "android:release": "node scripts/android-apk.mjs --release",
    "android:run": "node scripts/build-android.mjs && cap run android"
  },
  "build": {
    "appId": "com.marmol89.pulse",
    "productName": "Pulse",
    "icon": "src/assets/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "executableName": "pulse",
      "artifactName": "pulse-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Pulse-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fontsource/inter": "^5.3.0",
    "music-metadata": "^12.2.3"
  }
}
