{
  "name": "reproductor-mediator",
  "productName": "Pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Reproductor de música de escritorio (Windows/Linux) con Electron y patrón Mediator",
  "author": "marmol89 <admin@marmol89.com>",
  "main": "src/main/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "icons": "node scripts/generate-icon.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.example.reproductormediator",
    "productName": "Pulse",
    "icon": "src/assets/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "executableName": "pulse"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "music-metadata": "^12.2.3"
  }
}
