{
  "appId": "com.marmol89.pulse",
  "appName": "Pulse",
  "webDir": "www",
  "server": {
    "androidScheme": "http"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0E0E12"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
